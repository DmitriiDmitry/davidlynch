    2:     assert post_calls == [
    2:         (
    2:             "https://api.telegram.org/botsecret-token/sendMessage",
    2:             {"chat_id": "12345", "text": "hello", "parse_mode": "HTML"},
               )
           ]
    2:     assert capsys.readouterr().out == expected_output
       
       
    1: def test_send_today_weather_sends_friday_sequence(monkeypatch):
    1:     monkeypatch.setattr(main, "datetime", FixedDatetime)
    2:     monkeypatch.setattr(main, "get_weather", lambda: "current weather")
    2:     monkeypatch.setattr(main, "get_afternoon_forecast", lambda: "afternoon forecast")
    1:     messages = []
    1:     sleeps = []
    1:     monkeypatch.setattr(main, "send_telegram_message", messages.append)
    1:     monkeypatch.setattr(main.time, "sleep", sleeps.append)
       
    1:     main.send_today_weather()
       
    1:     assert messages == [
               "Good morning",
               "It's January 17, 2025\nand if YOU CAN BELIEVE IT - IT'S A FRIDAY ONCE AGAIN!!!",
               "current weather",
               "afternoon forecast",
               "And it looks like we're going to be enjoying beautiful blue skies and golden sunshine all along the way!",
               "Everyone, Have a great day!",
           ]
    1:     assert sleeps == [3, 3, 3, 3, 4, 2]
       
       
